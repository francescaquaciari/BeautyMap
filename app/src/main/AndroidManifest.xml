<?xml version="1.0" encoding="utf-8"?>
<!--definisce lo spazio per i nomi degli attributi standard di android -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--PERMESSI PER L'APP-->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--posizione approssimativa-->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--posizione precisa-->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--CONFIGURAZIONI GENERALI-->
    <application
        android:name=".MyApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeautyMap">
        <!--DEFINIZIONE DELLA SCHERMATA PRINCIPALE-->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BeautyMap">
            <intent-filter>
                <!--ruolo di questa atttività all'interno del SO-->
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--DEFINIZIONE DEL FILE DI CONFIGURAZIONE-->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
    </application>

</manifest>